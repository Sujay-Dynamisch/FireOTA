{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@fireota/react-native": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "typings",
    "templates"
  ]
}
